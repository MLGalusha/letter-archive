# Database
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Server
PORT=3002

# Storage
STORAGE_DIR=./storage

# CORS (optional - defaults to localhost origins for development)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# OpenAI (optional - stub mode if not set)
# These are provided by the parent direnv (.envrc) — see ~/Workspace/projects/ENV_SETUP.md
# Only set here if you need to override the shared values.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4

# JWT Authentication
# IMPORTANT: Change this in production! Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production
# Token expiry (default: 24h). Supports: 1h, 12h, 24h, 7d, etc.
# JWT_EXPIRY=24h

# Google Cloud Vision (optional - for OCR word-box detection)
# On GCP (Cloud Run etc.) ADC is automatic. Only needed locally with a key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

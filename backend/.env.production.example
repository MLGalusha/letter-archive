# ---- Database ----
# Cloud SQL connection string (use Unix socket for Cloud Run + Cloud SQL proxy)
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://app:CHANGE_ME@/app?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ---- Server ----
# Cloud Run injects PORT automatically — do not hardcode in production
PORT=8080
NODE_ENV=production

# ---- AI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# ---- Auth (being added in parallel) ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRY=7d

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com

# ---- Storage ----
# Local filesystem path inside the container (or mount a persistent volume)
STORAGE_DIR=/app/storage

# Google Cloud Storage bucket for letter images (future)
# GCS_BUCKET=your-bucket-name

# ---- Google Cloud Vision (optional) ----
# On Cloud Run with a service account, ADC is automatic — no key file needed.
# Only set this if running outside GCP with a key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

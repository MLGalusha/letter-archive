# ---- Database ----
# Cloud SQL connection string (use Unix socket for Cloud Run + Cloud SQL proxy)
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://app:CHANGE_ME@/app?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ---- Server ----
# Cloud Run injects PORT automatically — do not hardcode in production
PORT=8080
NODE_ENV=production
SITE_URL=https://yourdomain.com

# ---- AI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# ---- Auth (being added in parallel) ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRY=7d
ALLOW_ADMIN_SETUP=false
SEED_DEV_ADMIN=false

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com

# ---- Storage ----
# Mount a Cloud Storage bucket or other persistent volume here.
STORAGE_DIR=/mnt/archive

# Cloud Run logs should go to stdout/stderr instead of local files.
LOG_TO_FILES=false

# ---- Google Cloud ----
# Project ID for Cloud Logging trace correlation.
# Cloud Run injects GOOGLE_CLOUD_PROJECT automatically in most cases,
# but set explicitly if using custom service accounts.
# GOOGLE_CLOUD_PROJECT=your-project-id

# ---- Google Cloud Vision (optional) ----
# On Cloud Run with a service account, ADC is automatic — no key file needed.
# Only set this if running outside GCP with a key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

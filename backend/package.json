{
  "name": "letter-archive-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.20.1 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "admin:create": "node dist/cli/create-admin.js",
    "migrate:prod": "node dist/cli/migrate.js",
    "typecheck": "tsc --noEmit",
    "logs:query": "tsx scripts/query-logs.ts",
    "logs:errors": "tsx scripts/query-logs.ts --level error --hours 24",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate-migrations": "vitest run src/db/__tests__/migrations.test.ts",
    "db:test-migrations": "bash scripts/test-migrations.sh"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}

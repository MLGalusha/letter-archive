{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-page-supervisor-pass1-decision-v2.schema.json",
  "title": "Full-page supervisor pass-1 agent decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "page_id",
    "page_run_order",
    "model_tier",
    "source_sha256",
    "public_packet_sha256",
    "hidden_prior_answer_access",
    "lines"
  ],
  "properties": {
    "schema_version": {"const": "full-page-supervisor-pass1-decision.v2"},
    "trial_id": {"const": "full-page-supervisor-trial-v2"},
    "page_id": {"enum": ["007-p02", "014-p04"]},
    "page_run_order": {"enum": [1, 2]},
    "model_tier": {"enum": ["terra", "sol"]},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "public_packet_sha256": {"$ref": "#/$defs/sha256"},
    "hidden_prior_answer_access": {"const": false},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/line"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "reading_order",
        "bbox_source_xywh",
        "tentative_text",
        "unit_kind",
        "source_proposal_ids",
        "proposal_action",
        "alignment_status",
        "ownership_route",
        "risk_flags",
        "evidence_note"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "reading_order": {"type": "integer", "minimum": 1},
        "bbox_source_xywh": {"$ref": "#/$defs/bbox"},
        "tentative_text": {"type": "string", "minLength": 1},
        "unit_kind": {"enum": ["word", "punctuation", "non_word_mark", "unreadable"]},
        "source_proposal_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "proposal_action": {"enum": ["accept", "revise", "merge", "split", "add"]},
        "alignment_status": {"enum": ["matched", "corrected", "inserted_visible", "uncertain", "not_applicable"]},
        "ownership_route": {"enum": ["terra_box_mask", "sol_shared_ink", "human"]},
        "risk_flags": {
          "type": "array",
          "items": {
            "enum": [
              "none",
              "touching_neighbor",
              "shared_component",
              "fragmented",
              "faint",
              "fold",
              "stain",
              "sideways",
              "vertical",
              "curved",
              "transcript_conflict",
              "clipped_context",
              "unreadable"
            ]
          },
          "uniqueItems": true
        },
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "drop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "disposition", "evidence_note"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["duplicate", "empty", "punctuation_only", "non_word_mark", "wrong_line", "superseded_by_merge", "superseded_by_split"]},
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "line_reading_order",
        "registration_status",
        "upright_rotation_degrees",
        "directed_reading",
        "context_status",
        "transcript_proposal_disposition",
        "final_tentative_transcript",
        "visible_units",
        "dropped_proposals",
        "line_status",
        "line_evidence_note"
      ],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "line_reading_order": {"type": "integer", "minimum": 1},
        "registration_status": {"enum": ["approved", "sol_review", "human_review"]},
        "upright_rotation_degrees": {"type": "number", "minimum": -180, "maximum": 180},
        "directed_reading": {"enum": ["left_to_right", "right_to_left", "top_to_bottom", "bottom_to_top"]},
        "context_status": {"enum": ["sufficient", "too_tight", "too_wide", "wrong_rotation", "missing_neighbor", "unreadable_render"]},
        "transcript_proposal_disposition": {"enum": ["accepted", "corrected", "partially_uncertain", "rejected"]},
        "final_tentative_transcript": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "visible_units": {
          "type": "array",
          "items": {"$ref": "#/$defs/unit"}
        },
        "dropped_proposals": {
          "type": "array",
          "items": {"$ref": "#/$defs/drop"}
        },
        "line_status": {"enum": ["ready_for_ownership", "needs_sol", "needs_human"]},
        "line_evidence_note": {"type": "string", "minLength": 1}
      }
    }
  }
}

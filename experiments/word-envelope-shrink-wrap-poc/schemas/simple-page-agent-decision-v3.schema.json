{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simple-page-agent-decision-v3.schema.json",
  "title": "Simple page agent decision v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action"],
  "properties": {
    "schema_version": {"const": "simple-page-agent-decision.v3"},
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ink_variant", "rectangles", "deselect_rectangles"],
          "properties": {
            "type": {"const": "select_or_refine"},
            "ink_variant": {"const": "clean"},
            "rectangles": {"$ref": "#/$defs/rectangles"},
            "deselect_rectangles": {"$ref": "#/$defs/optionalRectangles"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "commit_word"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "recover_source_ink"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile"],
          "properties": {
            "type": {"const": "choose_recovery"},
            "profile": {"enum": ["original", "conservative", "balanced", "maximum_recall"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "points", "width_px"],
          "properties": {
            "type": {"const": "apply_cut"},
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "items": {"$ref": "#/$defs/point"}
            },
            "width_px": {"type": "integer", "minimum": 1, "maximum": 12}
          }
        }
      ]
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rectangle": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "rectangles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/rectangle"}
    },
    "optionalRectangles": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/rectangle"}
    }
  }
}

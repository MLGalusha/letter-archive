{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simple-page-transcription-first-decision-v1.schema.json",
  "title": "Simple page transcription-first decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lines"],
  "properties": {
    "schema_version": {"const": "simple-page-transcription-first-decision.v1"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/line"}
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_order", "text", "reading_status"],
      "properties": {
        "token_order": {"type": "integer", "minimum": 1, "maximum": 200},
        "text": {"type": "string", "minLength": 1, "maxLength": 100},
        "reading_status": {
          "enum": ["readable", "uncertain", "unreadable", "nonword_mark"]
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_order", "line_kind", "tokens"],
      "properties": {
        "line_order": {"type": "integer", "minimum": 1, "maximum": 200},
        "line_kind": {
          "enum": ["body", "postscript", "closing", "signature", "margin", "other"]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    }
  }
}

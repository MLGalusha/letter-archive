{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transcript-blind-inventory-decision-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "page_id",
    "page_run_order",
    "model_tier",
    "source_sha256",
    "inventory_packet_sha256",
    "transcript_access",
    "hidden_prior_answer_access",
    "lines"
  ],
  "properties": {
    "schema_version": {"const": "transcript-blind-inventory-decision.v2"},
    "trial_id": {"const": "full-page-supervisor-trial-v2"},
    "page_id": {"enum": ["007-p02", "014-p04"]},
    "page_run_order": {"enum": [1, 2]},
    "model_tier": {"enum": ["terra", "sol"]},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_packet_sha256": {"$ref": "#/$defs/sha256"},
    "transcript_access": {"const": false},
    "hidden_prior_answer_access": {"const": false},
    "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "reading_order", "bbox_source_xywh", "source_proposal_ids",
        "proposal_action", "visual_kind", "text_guess", "review_route",
        "risk_flags", "evidence_note"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "reading_order": {"type": "integer", "minimum": 1},
        "bbox_source_xywh": {"$ref": "#/$defs/bbox"},
        "source_proposal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "proposal_action": {"enum": ["accept", "revise", "merge", "split", "add"]},
        "visual_kind": {"enum": ["word_like", "punctuation", "non_word_mark", "unreadable"]},
        "text_guess": {"type": ["string", "null"], "minLength": 1},
        "review_route": {"enum": ["terra_ready", "sol", "human"]},
        "risk_flags": {
          "type": "array",
          "items": {"enum": ["none", "touching_neighbor", "shared_component", "fragmented", "faint", "fold", "stain", "sideways", "vertical", "curved", "clipped_context", "unreadable", "uncertain_word_boundary"]},
          "uniqueItems": true
        },
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "drop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "disposition", "evidence_note"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["duplicate", "empty", "punctuation_only", "non_word_mark", "wrong_line", "superseded_by_merge", "superseded_by_split"]},
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id", "line_reading_order", "registration_status",
        "upright_rotation_degrees", "directed_reading", "context_status",
        "visible_units", "dropped_proposals", "line_status", "line_evidence_note"
      ],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "line_reading_order": {"type": "integer", "minimum": 1},
        "registration_status": {"enum": ["approved", "sol_review", "human_review"]},
        "upright_rotation_degrees": {"type": "number", "minimum": -180, "maximum": 180},
        "directed_reading": {"enum": ["left_to_right", "right_to_left", "top_to_bottom", "bottom_to_top"]},
        "context_status": {"enum": ["sufficient", "too_tight", "too_wide", "wrong_rotation", "missing_neighbor", "unreadable_render"]},
        "visible_units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
        "dropped_proposals": {"type": "array", "items": {"$ref": "#/$defs/drop"}},
        "line_status": {"enum": ["inventory_ready", "needs_sol", "needs_human"]},
        "line_evidence_note": {"type": "string", "minLength": 1}
      }
    }
  }
}

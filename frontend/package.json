{
  "name": "fragments-of-us",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.20.1 <21 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "node ./scripts/dev-lan.mjs",
    "prebuild": "node ./scripts/generate-robots.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ci": "node --test scripts/lint-baseline.node-test.mjs && node scripts/check-lint.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@mdxeditor/editor": "^3.52.5",
    "@noble/hashes": "^2.2.0",
    "@tiptap/extension-document": "^3.21.0",
    "@tiptap/extension-paragraph": "^3.21.0",
    "@tiptap/extension-text": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
